# Scenario clock. Evaluators replay the run at this instant (Asia/Karachi, UTC+5).
# Do not use the wall clock as "now".
SCENARIO_NOW=2026-10-15T08:30:00+05:00

# Google AI Studio keys. Leave blank to use data/ocr_snapshot.json.
# GEMINI_API_KEY is an alias for key 1. Each key tries its base model, then fallbacks.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_KEY1_BASE_MODEL=gemini-2.5-flash
GEMINI_KEY1_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_KEY2_BASE_MODEL=gemini-2.5-flash
GEMINI_KEY2_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# Delivery channel label: outbox, whatsapp_cloud, whatsapp, or telegram.
# Outbox always writes; Cloud/Twilio/Telegram send when their vars are set.
NOTIFIER_CHANNEL=outbox

# Test recipient only (digits or whatsapp:+E164). Never dataset numbers.
TEST_RECIPIENT_WHATSAPP=

# Meta WhatsApp Cloud API (preferred when Twilio is unavailable).
WHATSAPP_CLOUD_SENDING_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_GRAPH_VERSION=v21.0

# Twilio WhatsApp Sandbox (optional).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Telegram Bot API fallback. Send only to TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
