# Scenario clock. Evaluators replay the run at this instant (Asia/Karachi, UTC+5).
# Do not use the wall clock as "now".
SCENARIO_NOW=2026-10-15T08:30:00+05:00

# Google AI Studio free key for gemini-2.5-flash. Leave blank to use data/ocr_snapshot.json.
GEMINI_API_KEY=

# Delivery channel: whatsapp, telegram, or outbox.
# outbox writes outbox/controller_summary_2026-09.txt and prints the message.
NOTIFIER_CHANNEL=outbox

# Twilio WhatsApp Sandbox. Send only to TEST_RECIPIENT_WHATSAPP, never to dataset numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TEST_RECIPIENT_WHATSAPP=

# Telegram Bot API fallback. Send only to TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
