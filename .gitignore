# Secrets and local environment — never commit
.env
.env.local
.env.*.local
*.pem
*.key
credentials*.json
secrets/

# Local SQLite state and Python caches
*.db
*.sqlite
*.sqlite3
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Python

# Virtual environments
.venv/
venv/
env/

# Runtime outputs (may contain test recipient traffic)
outbox/
*.log

# Generated review crops (regenerated by the extractor)
data/crops/*
!data/crops/.gitkeep

# Extra register photos uploaded from the review desk
data/uploads/*

# Editor / OS
.cursor/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Packaging / tooling
dist/
build/
*.egg-info/
.coverage
htmlcov/
